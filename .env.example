# Copy to .env and fill in. Only OPENAI_API_KEY is required.
OPENAI_API_KEY=
# openai (default) or fake (offline, lexical hashing embeddings; for tests only)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# Pin demo dates (the hero transaction is "yesterday" relative to this). Empty = today.
SEED_ANCHOR_DATE=
# Set to 1 to wipe and re-seed the mock bank data on the next ingest.
RESEED=0
# Models (defaults shown). LLM_PROVIDER=fake runs the graph with no key (tests only).
LLM_PROVIDER=openai
SUPERVISOR_MODEL=gpt-5.4-mini
COMPOSER_MODEL=gpt-5.4-mini
REWRITE_MODEL=gpt-5.4-nano
